rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dueño (el mismo correo que en config.js)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['kirvytuby@gmail.com'];
    }
    // Dueño o usuario dado de alta en la pestaña "Usuarios"
    function isAdmin() {
      return isOwner() || (request.auth != null && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    // Cada empresa inicia sesión como <id>@empresas.example.com con su PIN
    function isEmpresa(id) {
      return request.auth != null
        && request.auth.token.email == id + '@empresas.example.com';
    }
    function activa(id) {
      return get(/databases/$(database)/documents/empresas/$(id)).data.activo == true;
    }

    // Datos de la empresa (sin PIN). La empresa solo puede leer el suyo.
    match /empresas/{id} {
      allow read: if isAdmin() || isEmpresa(id);
      allow write: if isAdmin();

      // Registro de cada archivo subido
      match /archivos/{archivoId} {
        allow read: if isAdmin() || (isEmpresa(id) && activa(id));
        allow create: if isEmpresa(id) && activa(id)
          && request.resource.data.keys().hasOnly(['nombre','ruta','url','tipo','tamano','nota','fecha','revisado','empresaId','almacen','partes'])
          && request.resource.data.empresaId == id
          && request.resource.data.revisado == false
          && request.resource.data.fecha == request.time
          && (!('ruta' in request.resource.data) || request.resource.data.ruta.matches('empresas/' + id + '/.*'))
          && request.resource.data.nota.size() <= 300;
        allow update, delete: if isAdmin();

        // Modo gratis: el contenido del archivo, en partes
        match /partes/{n} {
          allow read: if isAdmin() || (isEmpresa(id) && activa(id));
          allow create: if isEmpresa(id) && activa(id)
            && request.resource.data.keys().hasOnly(['d'])
            && request.resource.data.d is string
            && request.resource.data.d.size() <= 820000;
          allow delete: if isAdmin();
        }
      }
    }

    // Usuarios del panel: solo el dueño los administra
    match /admins/{correo} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == correo);
      allow write: if isOwner();
    }

    // Contraseñas de usuarios del panel: solo el dueño
    match /privadoUsu/{correo} {
      allow read, write: if isOwner();
    }

    // PINs: solo administradores
    match /privado/{id} {
      allow read, write: if isAdmin();
    }

    // Bandeja general (consulta de todos los archivos): solo el administrador
    match /{path=**}/archivos/{archivoId} {
      allow read: if isAdmin();
    }
  }
}
